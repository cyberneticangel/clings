#!/usr/bin/env bash
#
# clings - small exercises to get you used to reading and writing C.
#
# usage: ./clings [command] [exercise]
#
#   watch            (default) work through the exercises in order, re-checking
#                    every time you save a file. Keys: [n] next (once the
#                    exercise passes), [h] hint, [l] list, [r] re-run, [q] quit
#   run <name>       compile and run a single exercise
#   hint <name>      show the hint for an exercise
#   list             show every exercise and whether it is done
#   verify           check every exercise in order, stop at the first unfinished
#   next             print the name and path of the next unfinished exercise
#
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT" || exit 1

EX_DIR="${CLINGS_DIR:-exercises}"
BUILD="$ROOT/.build/$EX_DIR"
CC="${CC:-cc}"
CFLAGS=(-std=c17 -Wall -Wextra -Werror -g -O0
        -fsanitize=address,undefined -fno-sanitize-recover=all
        -fno-omit-frame-pointer -I "$ROOT/include")
MARKER="I AM NOT DONE"
# LeakSanitizer only exists on Linux; asking for it elsewhere is an error.
if [[ "$(uname -s)" == Linux ]]; then
    export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=1}"
fi
export UBSAN_OPTIONS="${UBSAN_OPTIONS:-print_stacktrace=1}"

if [[ -t 1 ]]; then
    RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'
    BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'
else
    RED=; GREEN=; YELLOW=; BOLD=; DIM=; RESET=
fi

mkdir -p "$BUILD"

# ---- exercise list -------------------------------------------------------

PATHS=()
while read -r line; do
    PATHS+=("$EX_DIR/$line")
done < <(grep -v '^[[:space:]]*\(#\|$\)' "$ROOT/info")
TOTAL=${#PATHS[@]}

name_of() { local b; b=$(basename "$1"); echo "${b%.c}"; }

path_of() {
    local p
    for p in "${PATHS[@]}"; do
        [[ "$(name_of "$p")" == "$1" ]] && { echo "$p"; return 0; }
    done
    echo "${RED}No exercise named '$1'. Try ./clings list${RESET}" >&2
    return 1
}

# Only a line that is exactly the marker counts, so exercises can still
# mention the phrase in their instructions.
MARKER_RE="^[[:space:]]*//[[:space:]]*${MARKER}[[:space:]]*\$"
has_marker() { grep -qE "$MARKER_RE" "$1" "$(dirname "$1")"/*.h 2>/dev/null; }

# Run with a time limit, if a `timeout` command is available.
if command -v timeout >/dev/null 2>&1; then
    TIMEOUT=(timeout 5)
elif command -v gtimeout >/dev/null 2>&1; then
    TIMEOUT=(gtimeout 5)
else
    TIMEOUT=()
fi

# Deletes the marker line(s) from an exercise. Rewrites the file in place
# (instead of `sed -i`, which differs between GNU and BSD/macOS).
remove_marker() {
    local tmp
    tmp=$(mktemp) || return 1
    grep -vE "$MARKER_RE" "$1" >"$tmp"
    cat "$tmp" >"$1"
    rm -f "$tmp"
}

# ---- compile & run -------------------------------------------------------

# Latest modification time of the exercise and anything it may include.
src_stamp() {
    find "$1" "$(dirname "$1")" -maxdepth 1 -name '*.h' -newer "$2" 2>/dev/null | head -1
}

# Compiles and runs an exercise. Output goes to stdout.
# Returns 0 when it compiles and every check passes.
run_exercise() {
    local path=$1 quiet=${2:-} name bin okstamp out status
    name=$(name_of "$path")
    bin="$BUILD/$name"
    okstamp="$BUILD/$name.ok"

    # Cache: passed before and nothing changed since.
    if [[ -n "$quiet" && -f "$okstamp" && -z "$(src_stamp "$path" "$okstamp")" \
          && "$okstamp" -nt "$ROOT/include/clings.h" && ! "$path" -nt "$okstamp" ]]; then
        return 0
    fi
    rm -f "$okstamp"

    if ! out=$("$CC" "${CFLAGS[@]}" "$path" -o "$bin" -lm 2>&1); then
        [[ -z "$quiet" ]] && {
            echo "${RED}${BOLD}Compilation of $path failed! Compiler output:${RESET}"
            echo "$out"
        }
        return 1
    fi
    [[ -z "$quiet" && -n "$out" ]] && echo "$out"

    if [[ -n "$quiet" ]]; then
        (cd "$(dirname "$path")" && ${TIMEOUT[@]+"${TIMEOUT[@]}"} "$bin" </dev/null >/dev/null 2>&1)
    else
        (cd "$(dirname "$path")" && ${TIMEOUT[@]+"${TIMEOUT[@]}"} "$bin" </dev/null 2>&1)
    fi
    status=$?
    if [[ $status -eq 0 ]]; then
        touch "$okstamp"
        return 0
    fi
    if [[ -z "$quiet" ]]; then
        if [[ $status -eq 124 ]]; then
            echo "${RED}${BOLD}$name timed out after 5 seconds. Infinite loop?${RESET}"
        else
            echo "${RED}${BOLD}$name failed (exit status $status).${RESET}"
        fi
    fi
    return 1
}

is_done() { run_exercise "$1" quiet && ! has_marker "$1"; }

# Index of first unfinished exercise, or TOTAL if all done.
first_unfinished() {
    local i
    for ((i = 0; i < TOTAL; i++)); do
        is_done "${PATHS[$i]}" || { echo "$i"; return; }
    done
    echo "$TOTAL"
}

progress_bar() {
    local done=$1 width=50 filled bar
    filled=$((done * width / TOTAL))
    bar=$(printf '%*s' "$filled" '' | tr ' ' '#')
    bar+=$(printf '%*s' "$((width - filled))" '' | tr ' ' '-')
    printf 'Progress: [%s] %d/%d\n' "$bar" "$done" "$TOTAL"
}

show_hint() {
    local f="$ROOT/hints/$1.txt"
    if [[ -f "$f" ]]; then
        echo "${YELLOW}${BOLD}Hint for $1:${RESET}"
        cat "$f"
    else
        echo "No hint for $1, sorry! Re-read the comments in the exercise."
    fi
}

# ---- commands ------------------------------------------------------------

cmd_run() {
    local path
    path=$(path_of "$1") || exit 1
    if run_exercise "$path"; then
        echo "${GREEN}${BOLD}Successfully ran $path!${RESET}"
        has_marker "$path" && echo "${DIM}(to mark it done, press n in watch mode or delete the '// $MARKER' line)${RESET}"
        exit 0
    fi
    exit 1
}

cmd_list() {
    local p n=0
    printf "${BOLD}%-16s %-45s %s${RESET}\n" "Name" "Path" "Status"
    for p in "${PATHS[@]}"; do
        if is_done "$p"; then
            printf "%-16s %-45s ${GREEN}Done${RESET}\n" "$(name_of "$p")" "$p"
            n=$((n + 1))
        else
            printf "%-16s %-45s ${YELLOW}Pending${RESET}\n" "$(name_of "$p")" "$p"
        fi
    done
    echo
    progress_bar "$n"
}

cmd_verify() {
    local i
    for ((i = 0; i < TOTAL; i++)); do
        if ! is_done "${PATHS[$i]}"; then
            echo
            progress_bar "$i"
            echo "${YELLOW}Next up: ${PATHS[$i]}${RESET}"
            if run_exercise "${PATHS[$i]}"; then
                echo "${GREEN}It passes!${RESET} Press n in watch mode (or delete the '// $MARKER' line) to mark it done."
            fi
            exit 1
        fi
        echo "${GREEN}  ok${RESET} $(name_of "${PATHS[$i]}")"
    done
    progress_bar "$TOTAL"
    echo "${GREEN}${BOLD}All exercises done!${RESET}"
}

cmd_next() {
    local i
    i=$(first_unfinished)
    if ((i == TOTAL)); then echo "All done!"; else
        echo "$(name_of "${PATHS[$i]}") ${PATHS[$i]}"
    fi
}

WATCH_STAMP="$BUILD/.watch"

# True if any exercise/header changed since the last mark_watch.
changed_since_mark() {
    [[ -n "$(find "$EX_DIR" "$ROOT/include" -type f \( -name '*.c' -o -name '*.h' \) \
        -newer "$WATCH_STAMP" 2>/dev/null | head -1)" ]]
}
mark_watch() { touch "$WATCH_STAMP"; }

finished_banner() {
    cat <<EOF
${GREEN}${BOLD}
  +----------------------------------------------------------+
  |  You finished every clings exercise. Congratulations!    |
  |                                                          |
  |  Ideas for what's next:                                  |
  |   - "The C Programming Language" (K&R), 2nd edition      |
  |   - "Modern C" by Jens Gustedt (free online)             |
  |   - Write a small shell, a text editor, or a tiny VM     |
  |   - Read the source of a small C project you like        |
  +----------------------------------------------------------+
${RESET}
EOF
}

cmd_watch() {
    local i path key passed

    while true; do
        clear
        mark_watch
        i=$(first_unfinished)
        if ((i == TOTAL)); then
            progress_bar "$TOTAL"
            finished_banner
            exit 0
        fi
        path=${PATHS[$i]}

        echo "${BOLD}Current exercise: ${path}${RESET}"
        echo
        passed=0
        if run_exercise "$path"; then
            passed=1
            echo
            echo "${GREEN}${BOLD}Exercise $path compiles and all checks pass!${RESET}"
            echo "The code is ready. When you've read it through and understand it,"
            echo "press ${BOLD}n${RESET} for the next exercise (or delete the ${BOLD}// $MARKER${RESET} line)."
        fi
        echo
        progress_bar "$i"
        if ((passed)); then
            echo "${DIM}[n] next  [h] hint  [l] list  [r] re-run  [q] quit${RESET}"
        else
            echo "${DIM}[h] hint  [l] list  [r] re-run  [q] quit  (saving a file re-runs automatically)${RESET}"
        fi

        while true; do
            if read -r -s -n 1 -t 1 key; then
                case "$key" in
                    n)
                        if ((passed)); then
                            remove_marker "$path"
                            break
                        fi
                        echo
                        echo "${YELLOW}Not yet! $(name_of "$path") has to compile and pass its checks first.${RESET}"
                        ;;
                    h) echo; show_hint "$(name_of "$path")" ;;
                    l) echo; cmd_list ;;
                    r) break ;;
                    q) echo "Bye! Run ./clings to pick up where you left off."; exit 0 ;;
                esac
            fi
            changed_since_mark && break
        done
    done
}

# Prints the comment block at the top of this file.
usage() { sed -n '3,/^[^#]/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'; }

case "${1:-watch}" in
    watch)  cmd_watch ;;
    run)    [[ $# -ge 2 ]] || { usage; exit 1; }; cmd_run "$2" ;;
    hint)   [[ $# -ge 2 ]] || { usage; exit 1; }; path_of "$2" >/dev/null || exit 1; show_hint "$2" ;;
    list)   cmd_list ;;
    verify) cmd_verify ;;
    next)   cmd_next ;;
    -h|--help|help) usage ;;
    *)      usage; exit 1 ;;
esac
